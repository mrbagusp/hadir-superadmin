# ============================================================
# HADIR — Firebase Configuration
# ============================================================
# 1. Buka https://console.firebase.google.com
# 2. Buat project baru (atau pakai yang sudah ada)
# 3. Klik gear icon → Project Settings → General
# 4. Scroll ke bawah, klik "Add app" → Web (</>)
# 5. Copy config values ke bawah ini
# 6. Rename file ini menjadi .env
# ============================================================

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ============================================================
# CATATAN:
# - Prefix VITE_ wajib agar Vite bisa membaca variabel ini
# - Jangan commit file .env ke GitHub!
# - File .env sudah ada di .gitignore
# - Tanpa mengisi file ini, app tetap berjalan dalam Demo Mode
# ============================================================

# ============================================================
# SUPER ADMIN
# ============================================================
# Comma-separated list of emails that can access Super Admin
VITE_SUPERADMIN_EMAILS=admin@blessingmediaglobal.com
